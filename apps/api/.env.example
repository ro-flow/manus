# Database (Azure Database for PostgreSQL)
DATABASE_URL=postgresql://user:password@server.postgres.database.azure.com:5432/roflow?sslmode=require

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=aanvragen

# Azure Document Intelligence (PDF extractie)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_key_here

# PDOK — gratis, geen API key nodig
PDOK_LOCATIESERVER=https://api.pdok.nl/bzk/locatieserver/search/v3_1
PDOK_RUIMTELIJKEPLANNEN=https://service.pdok.nl/rws/ruimtelijkeplannen/wfs/v1_0

# AI Provider: 'groq' (MVP) of 'azure-openai' (productie)
AI_PROVIDER=groq

# Groq (MVP)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-8b-8192

# Azure OpenAI (later)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_MODEL=gpt-4o

# Server
PORT=3001
